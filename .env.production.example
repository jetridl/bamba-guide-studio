# Copy to /opt/bamba-studio/.env on Hetzner; chmod 600 .env.
# Single quotes keep $, # and other dotenv-special characters literal.
# Replace this example before starting. Generate with: openssl rand -hex 32
DB_PASSWORD='REPLACE_WITH_A_RANDOM_SECRET'
# Output of id -u / id -g for the owner of /opt/bamba-studio/exports and guides.
STUDIO_UID=1000
STUDIO_GID=1000
# Must match the locally built and loaded images. Prefer a release-specific tag.
STUDIO_IMAGE_TAG=latest
