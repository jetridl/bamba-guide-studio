{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bamba.local/schemas/guided-plan.schema.json",
  "title": "Bamba Guided Plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "guide",
    "poem",
    "stanzas",
    "lines",
    "chunks",
    "sessions"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "guide": {
      "type": "object",
      "required": [
        "id",
        "poemId",
        "title",
        "version",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "poemId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved",
            "exported"
          ]
        },
        "description": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "poem": {
      "type": "object",
      "required": [
        "id",
        "title",
        "author",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "stanzas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "orderIndex"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "orderIndex": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "stanzaId",
          "orderIndex",
          "stanzaOrderIndex",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "stanzaId": {
            "type": "string",
            "minLength": 1
          },
          "orderIndex": {
            "type": "integer",
            "minimum": 0
          },
          "stanzaOrderIndex": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "orderIndex",
          "lineIds"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "orderIndex": {
            "type": "integer",
            "minimum": 0
          },
          "lineIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "sessionNumber",
          "title",
          "orderIndex",
          "pages"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sessionNumber": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "subtitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "focusSummary": {
            "type": [
              "string",
              "null"
            ]
          },
          "orderIndex": {
            "type": "integer",
            "minimum": 0
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/page"
            }
          },
          "chunkIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "pageType": {
      "type": "string",
      "enum": [
        "intro",
        "context",
        "poet_background",
        "poem_background",
        "recap",
        "poem_chunk",
        "commentary",
        "first_word_game",
        "first_letter_game",
        "last_word_game",
        "first_last_word_game",
        "hidden_word_game",
        "reflection",
        "completion",
        "recap_previous",
        "whole_poem",
        "full_chunk_typing_game"
      ]
    },
    "roundType": {
      "type": "string",
      "enum": [
        "readThrough",
        "firstWord",
        "firstLetter",
        "lastWord",
        "firstAndLast",
        "hiddenWord",
        "fullChunkTyping"
      ]
    },
    "page": {
      "type": "object",
      "required": [
        "id",
        "type",
        "orderIndex"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/pageType"
        },
        "orderIndex": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "bodyMarkdown": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "chunkIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "roundType": {
          "anyOf": [
            {
              "$ref": "#/$defs/roundType"
            },
            {
              "type": "null"
            }
          ]
        },
        "estimatedSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
