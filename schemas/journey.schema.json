{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bamba.app/schemas/journey.schema.json",
  "title": "Bamba Guided Journey",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "journey",
    "poems"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "status",
        "title",
        "subtitle",
        "curator",
        "introduction"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "curator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "draft",
            "in_review",
            "approved",
            "exported"
          ]
        },
        "introduction": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "closing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "coverImage": {
          "type": "object",
          "description": "Cover image stored in the same folder as journey.json.",
          "additionalProperties": false,
          "required": [
            "path",
            "alt"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "File name only: no folders. PNG, JPEG or WebP.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*\\.(png|jpg|jpeg|webp)$"
            },
            "alt": {
              "type": "string",
              "description": "Text that describes the image for screen readers.",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "poems": {
      "type": "array",
      "minItems": 1,
      "description": "poemId must be unique within the journey (validated by the parser).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "poemId",
          "note"
        ],
        "properties": {
          "poemId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "note": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  }
}
